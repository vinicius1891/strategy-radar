# ===== API =====
# Porta da API NestJS
PORT=3001

# PostgreSQL (deixe vazio/ausente para rodar em modo demo em memoria)
DATABASE_URL=postgresql://radar:radar@localhost:5432/strategy_radar?schema=public

# Redis (deixe vazio/ausente para cache em memoria)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=7d

# Dados de mercado: "yahoo" (B3 real, gratis, padrao), "brapi" (B3 real, plano
# pago de brapi.dev) ou "synthetic" (dev offline, precos ficticios)
MARKET_DATA_PROVIDER=yahoo
BRAPI_TOKEN=
# Proxy opcional para o Yahoo (Cloudflare Worker — ver infra/cloudflare-yahoo-proxy.js).
# Necessario quando o servidor roda em datacenter cujo IP o Yahoo bloqueia.
YAHOO_PROXY_URL=

# ===== WEB =====
NEXT_PUBLIC_API_URL=http://localhost:3001
