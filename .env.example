# ===== API =====
# Porta da API NestJS
PORT=3001

# PostgreSQL (deixe vazio/ausente para rodar em modo demo em memoria)
DATABASE_URL=postgresql://radar:radar@localhost:5432/strategy_radar?schema=public

# Redis (deixe vazio/ausente para cache em memoria)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=7d

# Dados de mercado: "synthetic" (dev, sem rede) ou "brapi" (B3 real)
MARKET_DATA_PROVIDER=synthetic
BRAPI_TOKEN=

# ===== WEB =====
NEXT_PUBLIC_API_URL=http://localhost:3001
